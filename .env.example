# The scaffold runs without environment variables or external accounts.
# After npm run db:start, npm run db:env creates .env.local with local public values.
# For a hosted project, copy this file and replace placeholders locally instead.
# Canonical origin for auth emails/redirects. Use the same host in your browser.
# Hosted deployments must use HTTPS and match Supabase's Site URL/redirect allowlist.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Add server-only secrets only when an integration needs them.
# Never prefix a server secret with NEXT_PUBLIC_ or commit .env.local.

# Optional LOCAL demo seed only (npm run db:demo). Never set in hosted deployments.
# If absent, the script generates a password in ignored .env.demo.local.
# Use 12–72 characters. Existing demo accounts keep their original password.
# RENTIFY_DEMO_PASSWORD=replace-with-a-long-local-only-password

# Optional shell variable for npm run test:bookings:http; local HTTP origins only.
# Must match the running app's NEXT_PUBLIC_APP_URL. Default is shown below.
# RENTIFY_TEST_BASE_URL=http://localhost:3000

# B2.3 payment backend: disabled until explicitly configured. TEST MODE ONLY.
# All values below are server-only. Never use NEXT_PUBLIC_ for any of these.
# RENTIFY_PAYMENTS_ENABLED=false
# B2.4: separate opt-in after verifying the account's test refund support.
# RENTIFY_REFUNDS_ENABLED=false
# XENDIT_SECRET_KEY=xnd_development_replace_locally
# XENDIT_WEBHOOK_TOKEN=replace-with-test-webhook-verification-token
# Xendit requires HTTPS return URLs; use your actual test deployment/tunnel origin.
# XENDIT_RETURN_ORIGIN=https://your-test-app.example
# SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-supabase-service-role-key
# PAYMENTS_WORKER_SECRET=replace-with-at-least-32-random-characters
# Leave disabled until actual Xendit checkout/webhook/refund verification passes.
# Database/unit tests require no gateway account.
