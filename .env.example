# The scaffold runs without environment variables or external accounts.
# Copy to .env.local when starting Supabase integration; replace placeholders locally.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Add server-only secrets only when an integration needs them.
# Never prefix a server secret with NEXT_PUBLIC_ or commit .env.local.
