{
  "name": "rentify-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset --local --no-seed",
    "db:lint": "supabase db lint --local --schema public --fail-on warning",
    "db:test": "supabase test db --local",
    "db:test:bookings": "node --test supabase/scripts/booking-access.test.mjs supabase/scripts/booking-actions.test.mjs && node supabase/scripts/booking-concurrency.mjs",
    "test:bookings:http": "node --test supabase/scripts/booking-http.test.mjs",
    "db:test:payments": "node --test supabase/scripts/payment-access.test.mjs",
    "db:test:refunds": "node --test supabase/scripts/refund-access.test.mjs",
    "db:test:history": "node --test supabase/scripts/history-access.test.mjs",
    "test:payments:http": "node --test supabase/scripts/payment-http.test.mjs",
    "test:refunds:http": "node --test supabase/scripts/refund-http.test.mjs",
    "test:history:http": "node --test supabase/scripts/history-http.test.mjs",
    "payments:worker": "node --env-file-if-exists=.env.local supabase/scripts/payment-worker.mjs",
    "db:env": "node supabase/scripts/env.mjs",
    "db:types": "node supabase/scripts/types.mjs",
    "db:smoke": "node supabase/scripts/smoke.mjs",
    "db:demo": "node supabase/scripts/demo.mjs",
    "db:demo:reset": "node supabase/scripts/demo.mjs --reset",
    "db:demo:test": "node --test supabase/scripts/demo.test.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "lucide-react": "1.51.0",
    "next": "16.4.2",
    "radix-ui": "1.6.7",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "sonner": "2.0.8",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.2",
    "eslint-config-prettier": "10.1.8",
    "postcss": "8.5.30",
    "prettier": "3.9.10",
    "shadcn": "4.21.1",
    "supabase": "2.121.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
